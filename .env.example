MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=auto
MEDIA_S3_ORIGINALS_BUCKET=
MEDIA_S3_DISPLAY_BUCKET=
MEDIA_ACCESS_KEY_ID=
MEDIA_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_BASE_URL=
MEDIA_S3_FORCE_PATH_STYLE=false
