{
  "name": "sprtaya-kanaka-storefront",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "DATABASE_URL='mysql://localhost/sprtaya_build' prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"docs/**/*.md\" README.md package.json tsconfig.json next.config.mjs postcss.config.mjs eslint.config.mjs vitest.config.mts .prettierrc.json",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"docs/**/*.md\" README.md package.json tsconfig.json next.config.mjs postcss.config.mjs eslint.config.mjs vitest.config.mts .prettierrc.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run src/lib/server/mysql.integration.test.ts",
    "test:watch": "vitest",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate:dev": "node scripts/migrate-dev.mjs",
    "db:migrate:deploy": "tsx scripts/deploy-migrations.ts",
    "db:preflight": "tsx scripts/preflight-hostinger-phase2.ts",
    "db:preflight:hostinger": "tsx scripts/preflight-hostinger-phase2.ts",
    "db:seed": "tsx scripts/seed-database.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-owner.ts",
    "catalog:import": "tsx scripts/import-legacy-catalog.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/s3-request-presigner": "3.1156.0",
    "@swc/helpers": "0.5.23",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.14",
    "dotenv": "18.0.9",
    "mariadb": "3.5.4",
    "next": "16.4.3",
    "prisma": "7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
